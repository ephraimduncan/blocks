{
  "name": "blocks-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:registry": "bun run scripts/generate-registry.ts",
    "generate:blocks-data": "bun run scripts/generate-blocks-data.ts",
    "generate:rss": "bun run scripts/generate-rss.ts",
    "build": "opennextjs-cloudflare build",
    "build:next": "bun run generate:registry && bun run generate:blocks-data && bun run generate:rss && next build",
    "generate": "bun run generate:registry && bun run generate:blocks-data",
    "start": "next start",
    "lint": "bunx ultracite lint",
    "prepare": "simple-git-hooks",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "simple-git-hooks": {
    "commit-msg": "bunx commitlint --edit $1"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opennextjs/cloudflare": "^1.19.4",
    "@pierre/diffs": "^1.0.10",
    "@pierre/icons": "^0.1.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.68",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.1.2",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.2",
    "react-dropzone": "^14.3.8",
    "react-resizable-panels": "^4.0.0",
    "recharts": "3.8.0",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.1.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5",
    "ultracite": "5.0.39",
    "wrangler": "^4.85.0"
  },
  "overrides": {
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7"
  },
  "packageManager": "bun@1.4.0"
}
